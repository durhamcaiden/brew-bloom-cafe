  <main>
    <h2 class="section-title">Our Full Menu</h2>
    <p>All drinks are available hot, iced, or blended unless noted. Non-dairy milk substitutions available at no extra charge.</p>

    <!-- ===== ESPRESSO TABLE ===== -->
